{
  "name": "@trovyhq/sdk",
  "version": "1.0.5",
  "description": "Typed REST client for Trovy \u2014 used by the CLI, MCP server, and any script.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "keywords": [
    "trovy",
    "api-client",
    "typescript",
    "task-management"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/trovyhq/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/trovyhq/sdk/issues"
  },
  "devDependencies": {
    "@types/node": "^20.16.5",
    "typescript": "^5.6.2"
  }
}
